# =============================================================================
# LuxRide Docker Compose — shared environment variables
# Copy to .env in the repository root and adjust for your environment.
# Backend secrets (Stripe, SESSION_SECRET, DATABASE_URL) live in backend/.env
# =============================================================================

# --- Database mode ---
# Default: use DATABASE_URL from backend/.env (localhost is rewritten to host.docker.internal).
USE_LOCAL_DATABASE=1

# Optional bundled Postgres (demo/isolated stack only):
# COMPOSE_PROFILES=docker-db
# POSTGRES_PASSWORD=luxride

# --- Frontend (production build) ---
# Public URL the browser uses to reach the API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# --- Backend CORS / redirects (production compose interpolates these from root) ---
# Local docker: HTTP is fine. Production compose requires an absolute HTTPS URL.
# SMTP / EMAIL_ENABLED / MAIL_FROM are NOT set here — they live only in backend/.env
# (loaded via env_file on the backend service).
FRONTEND_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost

# --- Metrics (Prometheus scrape auth; must match backend METRICS_TOKEN) ---
METRICS_TOKEN=dev-metrics-token

# --- Alertmanager (optional Slack/PagerDuty webhook) ---
ALERTMANAGER_WEBHOOK_URL=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
