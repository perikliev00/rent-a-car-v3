# =============================================================================
# LuxRide Docker Compose — shared environment variables
# Copy to .env in the repository root and adjust for your environment.
# Backend secrets (Stripe, SESSION_SECRET, DATABASE_URL) live in backend/.env
# =============================================================================

# --- Database mode ---
# Default: use DATABASE_URL from backend/.env (localhost is rewritten to host.docker.internal).
USE_LOCAL_DATABASE=1

# Optional bundled Postgres (demo/isolated stack only):
# COMPOSE_PROFILES=docker-db
# POSTGRES_PASSWORD=luxride

# --- Frontend (production build) ---
# Public URL the browser uses to reach the API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000
# Optional: customer site URL baked into the admin image ("Back to site")
# VITE_CUSTOMER_FRONTEND_URL=http://localhost

# --- Backend CORS / redirects (production) ---
# FRONTEND_BASE_URL is the CUSTOMER site (Stripe success/cancel, email verify)
FRONTEND_BASE_URL=http://localhost
# Include both customer and admin origins. Local prod compose publishes admin on :8080.
CORS_ORIGINS=http://localhost,http://localhost:8080

# --- Metrics (Prometheus scrape auth; must match backend METRICS_TOKEN) ---
METRICS_TOKEN=dev-metrics-token

# --- Alertmanager ---
# Local/dev: optional webhook (used when ALERT_SMTP_* are unset)
ALERTMANAGER_WEBHOOK_URL=

# AWS Lightsail: use a dedicated untracked host file instead of this root .env:
#   /opt/rentacar/config/alertmanager.env
# See monitoring/alertmanager/alertmanager.env.example and
# docs/ops/production-alertmanager-email.md
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_FROM=alerts@example.com
# ALERT_SMTP_USERNAME=example-user
# ALERT_SMTP_PASSWORD=<secret>
# ALERT_EMAIL_TO=ops@example.com
# ALERT_SMTP_REQUIRE_TLS=true
# ALERTMANAGER_ENV_FILE=/opt/rentacar/config/alertmanager.env

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
