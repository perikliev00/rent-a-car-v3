{
  "name": "luxride",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage --testTimeout=60000 --json --outputFile=test-results/jest-results.json",
    "test:db": "node tests/runDbTests.js",
    "test:integration": "node tests/runIntegrationTests.js",
    "db:schema": "node sql/applySchema.js",
    "db:migrate": "node sql/migrate.js",
    "db:reset": "node sql/reset.js",
    "db:backup": "node sql/backup.js",
    "db:restore": "node sql/restore.js",
    "db:setup": "node sql/applySchema.js && node sql/migrate.js",
    "db:assert-migrations": "node scripts/assertMigrationsApplied.js",
    "reconcile:stripe": "node scripts/reconcileStripeSessions.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@sentry/node": "^10.62.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^7.0.0",
    "js-yaml": "^5.2.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.2",
    "stripe": "^18.1.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.0",
    "supertest": "^7.2.2"
  }
}
