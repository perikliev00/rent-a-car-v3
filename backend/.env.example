# =============================================================================
# LuxRide Backend — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Local development (npm run dev) and Docker (USE_LOCAL_DATABASE=1) both use this URL.
# Docker rewrites localhost → host.docker.internal automatically.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/rent_a_car
# Pool: PG_POOL_MAX × (API replicas + worker) must stay under managed max_connections − ~10.
# Defaults: max 20 (production) / 10 (dev) / 5 (test); connectionTimeout 5s; idleTimeout 30s (1s in test).
# PG_POOL_MAX=20
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000
# Session timeouts (ms). Production defaults: statement 15s, idle-in-tx 30s, lock 5s. Dev: off unless set.
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# PG_LOCK_TIMEOUT_MS=5000

# --- Session ---
# Must be at least 32 characters; avoid known weak values
# Production: secure cookies auto-enabled when NODE_ENV=production
# Use strict/lax; only use none if frontend is on a different site over HTTPS
# Do not set SESSION_COOKIE_SECURE=false in production (startup will refuse)
SESSION_SECRET=replace_me_with_32_plus_random_chars
SESSION_COOKIE_SAME_SITE=lax

# --- Frontend / CORS ---
FRONTEND_BASE_URL=http://localhost:5173
# Production: required HTTPS origins — comma-separated (customer and admin)
# Localhost / http origins are rejected when NODE_ENV=production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- OpenAPI / Swagger UI ---
# Non-production: docs always available at /api/v1/docs
# Production: set OPENAPI_DOCS_ENABLED=true (staff session required)
# OPENAPI_DOCS_ENABLED=false

# --- Stripe (test keys for local development) ---
# Production refuses STRIPE_STUB, sk_test_ keys, and placeholder whsec_ values
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_STUB=1

# --- Email (optional in development — required in production) ---
# Production: EMAIL_ENABLED=true and all SMTP_* / MAIL_FROM must be set
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com

# --- Support contact (shown on checkout cancel / success pages) ---
SUPPORT_EMAIL=support@rentacar.com
SUPPORT_PHONE=

# --- Image storage (public car photos only; does not store identity docs or checklists) ---
# local = files saved to disk; s3 = AWS S3 / compatible object storage
# Production: STORAGE_DRIVER=s3 is required (local public uploads are rejected)
STORAGE_DRIVER=local

# Uncomment when STORAGE_DRIVER=s3 (required in production for public car images):
# S3_BUCKET=your-bucket
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_REGION=auto
# S3_KEY_PREFIX=uploads/
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Private document storage (identity docs, signatures, checklist photos) ---
# local = disk under uploads/private; s3 = private bucket (no public URL / CDN)
PRIVATE_STORAGE_DRIVER=local
# Production with local driver: mount a persistent volume at /app/uploads/private and set:
# PRIVATE_STORAGE_PERSISTENT=true
# Recommended production: PRIVATE_STORAGE_DRIVER=s3 with a private (non-CDN) bucket
# PRIVATE_STORAGE_DRIVER=s3
# PRIVATE_S3_BUCKET=your-private-docs-bucket
# PRIVATE_S3_KEY_PREFIX=

# --- Background jobs ---
# In-process cleanup / notification timers. Default: enabled when unset (convenient for local `npm run dev`).
# Production: set RUN_BACKGROUND_JOBS=false on API replicas; run `npm run worker` (or the compose `worker` service) as the sole job executor.
# PostgreSQL advisory locks prevent double-runs if more than one worker is started by mistake.
# RUN_BACKGROUND_JOBS=false

# --- Observability (optional) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LOG_LEVEL=debug

# --- Metrics endpoint protection (optional) ---
# Required for Prometheus scraping in production Docker (docker-compose.prod.yml)
# METRICS_TOKEN=dev-metrics-token
# METRICS_ALLOWED_IPS=

# --- Admin (optional) ---
# DELETED_ORDERS_RETENTION_DAYS=30

# --- Database seed (development) ---
# Used by: npm run db:seed / npm run db:reset
SEED_ADMIN_EMAIL=admin@luxride.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO_USER_EMAIL=demo@luxride.local
SEED_DEMO_USER_PASSWORD=Demo123!
