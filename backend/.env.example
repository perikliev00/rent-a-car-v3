# =============================================================================
# LuxRide Backend — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Local development (npm run dev) and Docker (USE_LOCAL_DATABASE=1) both use this URL.
# Docker rewrites localhost → host.docker.internal automatically.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/rent_a_car

# --- Session ---
# Must be at least 32 characters; avoid known weak values
# Production: secure cookies auto-enabled when NODE_ENV=production
# Use strict/lax; only use none if frontend is on a different site over HTTPS
SESSION_SECRET=replace_me_with_32_plus_random_chars
SESSION_COOKIE_SAME_SITE=lax

# --- Frontend / CORS ---
# Development may use http://localhost. Production requires an absolute HTTPS URL
# because verification and claim tokens are placed in email links.
FRONTEND_BASE_URL=http://localhost:5173
# Production: required — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# --- OpenAPI / Swagger UI ---
# Non-production: docs always available at /api/v1/docs
# Production: set OPENAPI_DOCS_ENABLED=true (staff session required)
# OPENAPI_DOCS_ENABLED=false

# --- Stripe (test keys for local development) ---
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email ---
# Development: optional (EMAIL_ENABLED=false skips SMTP).
# Production: EMAIL_ENABLED=true and all SMTP vars are required. Customer email
# confirmation cannot be skipped in production.
# docker-compose.prod.yml loads these from this file via env_file — do not put
# SMTP_* in the Compose root .env (shell interpolation would override / diverge).
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com

# --- Support contact (shown on checkout cancel / success pages) ---
SUPPORT_EMAIL=support@rentacar.com
SUPPORT_PHONE=

# --- Image storage ---
# local = files saved to disk; s3 = AWS S3 / compatible object storage
STORAGE_DRIVER=local

# Uncomment when STORAGE_DRIVER=s3 (required in production for uploads):
# S3_BUCKET=your-bucket
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_REGION=auto
# S3_KEY_PREFIX=uploads/
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Background jobs ---
# In-process cleanup / notification timers. Default: enabled when unset.
# Set to false on extra scaled API replicas so only one process runs jobs.
# RUN_BACKGROUND_JOBS=true

# --- Observability (optional) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LOG_LEVEL=debug

# --- Metrics endpoint protection (optional) ---
# Required for Prometheus scraping in production Docker (docker-compose.prod.yml)
# METRICS_TOKEN=dev-metrics-token
# METRICS_ALLOWED_IPS=

# --- Admin (optional) ---
# DELETED_ORDERS_RETENTION_DAYS=30

# --- Database seed (development) ---
# Used by: npm run db:seed / npm run db:reset
SEED_ADMIN_EMAIL=admin@luxride.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO_USER_EMAIL=demo@luxride.local
SEED_DEMO_USER_PASSWORD=Demo123!
